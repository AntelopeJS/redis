{
  "name": "@antelopejs/redis",
  "version": "1.0.3",
  "description": "Redis module that implements the redis interface of antelopejs",
  "keywords": [
    "antelopejs",
    "cache",
    "key-value",
    "nosql",
    "redis"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/redis.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground --inspect",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-redis": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-redis-scheduler": ">=0.0.6 <1.0.0",
    "ioredis": "^5.10.1",
    "ioredis-mock": "^8.13.1"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/chai": "^4.3.20",
    "@types/ioredis-mock": "^8.2.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "chai": "^4.5.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-redis",
      "@antelopejs/interface-redis-scheduler"
    ],
    "defaultConfig": {
      "url": "redis://localhost:6379"
    },
    "test": "src/test/antelope.test.ts"
  }
}
